# APP_URL: The canonical URL where this application is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Required in production for signing auth cookies and short-lived PDF access tokens.
# Generate a strong 32+ byte random secret before production deployment.
SESSION_SECRET=""

# GATEWAY_ENCRYPTION_KEY: Optional dedicated key for encrypting payment gateway credentials in DB.
# Falls back to SESSION_SECRET if unset.
GATEWAY_ENCRYPTION_KEY=""

# TRUST_PROXY: Set to "true" only when behind a trusted reverse proxy setting X-Forwarded-For.
TRUST_PROXY="false"

# REQUIRE_EMAIL_VERIFICATION: Set to "true" to require verified email before checkout.
REQUIRE_EMAIL_VERIFICATION="false"

# SUPABASE CONFIGURATION (Required: Supabase is the only supported database and file storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ADMIN PROVISIONING (Never hardcode a production password; use CLI or bootstrap secret)
ADMIN_BOOTSTRAP_TOKEN=""

# PREMIER BANK GATEWAY — MASTERCARD / VISA (Server-side secrets only — never expose in VITE_* vars)
PREMIER_BANK_GATEWAY_URL=""
PREMIER_BANK_MERCHANT_ID=""
PREMIER_BANK_API_KEY=""
PREMIER_BANK_WEBHOOK_SECRET=""

# EMAIL DELIVERY (Optional — reports not_configured when absent)
RESEND_API_KEY=""
EMAIL_FROM="Khalid Sharif Digital Library <noreply@example.com>"
